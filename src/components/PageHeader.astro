---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Right-hand meta pairs, rendered as a small masthead block. */
  meta?: { label: string; value: string }[];
}
const { eyebrow, title, lead, meta = [] } = Astro.props;
---

<section class="border-b border-line">
  <div class="shell pt-14 pb-14 md:pt-24 md:pb-20" data-reveal-group>
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <div class="mt-6 grid gap-10 md:grid-cols-12 md:gap-8">
      <h1
        class="text-[2.5rem] leading-[1.05] md:col-span-7 md:text-[3.75rem] lg:text-[4.25rem]"
        data-reveal
      >
        {title}
      </h1>
      <div class="md:col-span-4 md:col-start-9">
        {lead && <p class="text-[1.0625rem] leading-relaxed text-ink-2" data-reveal>{lead}</p>}
        {
          meta.length > 0 && (
            <dl class="mt-8 divide-y divide-line border-t border-line" data-reveal>
              {meta.map((m) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="eyebrow">{m.label}</dt>
                  <dd class="text-right text-[0.9375rem] tnum">{m.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </div>
</section>
