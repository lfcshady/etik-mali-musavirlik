---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  meta?: { label: string; value: string }[];
  image: ImageMetadata;
  imageAlt: string;
}
const { eyebrow, title, lead, meta = [], image, imageAlt } = Astro.props;
---

<section class="relative overflow-hidden bg-navy text-paper">
  <div class="duotone scrim-even absolute inset-0 h-full w-full">
    <Image src={image} alt={imageAlt} width={2000} loading="eager" fetchpriority="high" />
  </div>

  <div class="shell relative z-10 pt-16 pb-14 md:pt-24 md:pb-20" data-reveal-group>
    <p class="eyebrow eyebrow-invert" data-reveal>{eyebrow}</p>
    <div class="mt-6 grid gap-10 md:grid-cols-12 md:gap-8">
      <h1
        class="max-w-[15ch] text-[2.75rem] leading-[1] md:col-span-7 md:text-[4.25rem] lg:text-[5rem]"
        data-reveal
      >
        {title}
      </h1>
      <div class="md:col-span-4 md:col-start-9 md:self-end">
        {lead && <p class="text-[1.0625rem] leading-relaxed text-paper/85" data-reveal>{lead}</p>}
        {
          meta.length > 0 && (
            <dl class="mt-8 divide-y divide-line-invert border-t border-line-invert" data-reveal>
              {meta.map((m) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-[0.8125rem] text-paper/70">{m.label}</dt>
                  <dd class="text-right text-[0.9375rem] font-semibold tnum">{m.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </div>
</section>
