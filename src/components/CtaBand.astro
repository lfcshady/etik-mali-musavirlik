---
import { site, telHref, mailHref, waHref } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Önce durumunuza bakalım.',
  text = 'İlk görüşme ücretsizdir ve bir şey satmaya çalışmadan geçer: mevcut kaydınıza bakar, eksik varsa söyler, kapsamı ve ücreti yazılı olarak paylaşırız.',
} = Astro.props;
---

<section class="shell" aria-labelledby="cta-baslik">
  <div class="border-t border-line pt-14 md:pt-20" data-reveal-group>
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <p class="eyebrow" data-reveal>İletişim</p>
        <h2
          id="cta-baslik"
          class="mt-5 text-[2rem] md:text-[2.75rem] lg:text-[3rem]"
          data-reveal
        >
          {title}
        </h2>
        <p class="mt-6 max-w-[52ch] text-[1.0625rem] leading-relaxed text-ink-2" data-reveal>
          {text}
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal>
          <a href="/iletisim" class="btn">Görüşme talep edin</a>
          <a
            href={waHref('Merhaba, mali müşavirlik hizmetleriniz hakkında bilgi almak istiyorum.')}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost">WhatsApp’tan yazın</a
          >
        </div>
      </div>

      <div class="md:col-span-4 md:col-start-9" data-reveal>
        <dl class="divide-y divide-line border-y border-line">
          <div class="py-4">
            <dt class="eyebrow">Telefon</dt>
            <dd class="mt-1.5"><a href={telHref} class="link-draw font-mono text-[1.0625rem]">{site.phoneDisplay}</a></dd>
          </div>
          <div class="py-4">
            <dt class="eyebrow">E-posta</dt>
            <dd class="mt-1.5"><a href={mailHref} class="link-draw text-[1.0625rem]">{site.email}</a></dd>
          </div>
          <div class="py-4">
            <dt class="eyebrow">Çalışma saatleri</dt>
            <dd class="mt-1.5 text-[1.0625rem] tnum">Pzt–Cum 09:00–18:30</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
