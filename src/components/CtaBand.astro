---
import Figure from './Figure.astro';
import { site, telHref, mailHref, waHref } from '../data/site';
import ctaImg from '../assets/skyline-up.jpg';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Önce durumunuza bakalım.',
  text = 'İlk görüşme ücretsizdir ve bir şey satmaya çalışmadan geçer: mevcut kaydınıza bakar, eksik varsa söyler, kapsamı ve ücreti yazılı olarak paylaşırız.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-navy py-20 text-paper md:py-28" aria-labelledby="cta-baslik">
  <Figure
    src={ctaImg}
    alt="Aşağıdan yukarı bakan açıyla iş merkezi kuleleri"
    width={2000}
    reveal={false}
    class="absolute inset-0 h-full w-full opacity-40"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy/92 to-navy/55"></div>

  <div class="shell relative z-10 grid gap-12 md:grid-cols-12 md:gap-8" data-reveal-group>
    <div class="md:col-span-6">
      <p class="eyebrow eyebrow-invert" data-reveal>İletişim</p>
      <h2 id="cta-baslik" class="mt-5 max-w-[14ch] text-[2.5rem] md:text-[3.5rem]" data-reveal>
        {title}
      </h2>
      <p class="mt-7 max-w-[50ch] text-[1.0625rem] leading-relaxed text-paper/75" data-reveal>
        {text}
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal>
        <a href="/iletisim" class="btn btn-light">Görüşme talep edin</a>
        <a
          href={waHref('Merhaba, mali müşavirlik hizmetleriniz hakkında bilgi almak istiyorum.')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost btn-ghost-invert">WhatsApp’tan yazın</a
        >
      </div>
    </div>

    <div class="md:col-span-5 md:col-start-8" data-reveal>
      <dl class="divide-y divide-line-invert border-y border-line-invert">
        <div class="py-5">
          <dt class="text-[0.8125rem] text-paper/55">Telefon</dt>
          <dd class="mt-1.5">
            <a href={telHref} class="link-draw font-display text-[1.375rem] tnum">{site.phoneDisplay}</a>
          </dd>
        </div>
        <div class="py-5">
          <dt class="text-[0.8125rem] text-paper/55">E-posta</dt>
          <dd class="mt-1.5"><a href={mailHref} class="link-draw text-[1.0625rem]">{site.email}</a></dd>
        </div>
        <div class="py-5">
          <dt class="text-[0.8125rem] text-paper/55">Çalışma saatleri</dt>
          <dd class="mt-1.5 text-[1.0625rem] tnum">Pzt–Cum 09:00–18:30</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
