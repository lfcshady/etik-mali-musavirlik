---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width hint for the optimiser. */
  width?: number;
  class?: string;
  imgClass?: string;
  /** Adds the dark legibility gradient for text laid over the image. */
  scrim?: boolean;
  priority?: boolean;
  reveal?: boolean;
}

const {
  src,
  alt,
  width = 1400,
  class: className = '',
  imgClass = '',
  scrim = false,
  priority = false,
  reveal = true,
} = Astro.props;
---

<div
  class:list={['duotone', scrim && 'scrim', className]}
  data-img-reveal={reveal ? '' : undefined}
>
  <Image
    src={src}
    alt={alt}
    width={width}
    densities={[1, 2]}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={imgClass}
  />
</div>
