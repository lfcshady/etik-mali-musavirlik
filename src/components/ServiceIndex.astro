---
import { services } from '../data/services';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? services.slice(0, limit) : services;
---

<ul class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
  {
    list.map((s) => (
      <li data-reveal>
        <a
          href={`/hizmetler/${s.slug}`}
          class="group flex h-full flex-col bg-paper p-7 transition-colors duration-500 hover:bg-surface md:p-8"
        >
          <span class="font-display text-[0.8125rem] tnum text-accent">{s.no}</span>
          <h3 class="mt-5 text-[1.5rem] leading-tight md:text-[1.75rem]">{s.title}</h3>
          <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-muted">{s.summary}</p>
          <span class="mt-7 flex items-center gap-2 text-[0.875rem] font-semibold text-accent">
            Detaya bakın
            <span
              aria-hidden="true"
              class="transition-transform duration-500 group-hover:translate-x-1.5"
            >
              →
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
