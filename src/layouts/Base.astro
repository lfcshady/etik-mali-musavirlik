---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Page path for canonical + og:url, e.g. '/hizmetler' */
  path?: string;
  /** Hero sits directly under the header on the home page. */
  headerVariant?: 'default' | 'flush';
}

const { title, description, path = '/', headerVariant = 'default' } = Astro.props;

const canonical = new URL(path, Astro.site ?? site.domain).toString();
const fullTitle = path === '/' ? title : `${title} — ${site.name}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: site.name,
  description,
  url: site.domain,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.maps.lat,
    longitude: site.maps.lng,
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
  openingHours: site.openingHours,
  sameAs: site.social.map((s) => s.href),
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? site.domain).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#F7F5F0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/newsreader-normal-300-600-latin-ext.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-sans-normal-400-latin-ext.woff2"
      crossorigin
    />

    <script is:inline>
      // Set before first paint so revealed elements never flash in and out.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-paper"
      >İçeriğe geç</a
    >

    <Header variant={headerVariant} />

    <main id="icerik">
      <slot />
    </main>

    <Footer />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.registerPlugin(ScrollTrigger);

        const EASE = 'expo.out';

        // Grouped fade-lift. Elements sharing a [data-reveal-group] animate as one
        // staggered batch instead of firing independently.
        const groups = new Map<Element, Element[]>();
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
          const parent = el.closest('[data-reveal-group]') ?? el.parentElement!;
          if (!groups.has(parent)) groups.set(parent, []);
          groups.get(parent)!.push(el);
        });

        groups.forEach((items) => {
          gsap.to(items, {
            opacity: 1,
            y: 0,
            duration: 0.85,
            ease: EASE,
            stagger: 0.07,
            scrollTrigger: { trigger: items[0], start: 'top 88%', once: true },
          });
        });

        document.querySelectorAll<HTMLElement>('[data-rule-draw]').forEach((el) => {
          gsap.to(el, {
            scaleX: 1,
            duration: 1.1,
            ease: EASE,
            scrollTrigger: { trigger: el, start: 'top 92%', once: true },
          });
        });

        // Counters: the only place a number moves on this site.
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const target = Number(el.dataset.count);
          const suffix = el.dataset.countSuffix ?? '';
          const state = { value: 0 };
          gsap.to(state, {
            value: target,
            duration: 1.4,
            ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 90%', once: true },
            onUpdate: () => {
              el.textContent = Math.round(state.value).toLocaleString('tr-TR') + suffix;
            },
          });
        });
      }
    </script>
  </body>
</html>
