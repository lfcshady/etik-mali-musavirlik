---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import headerImg from '../assets/facade-diagonal.jpg';

const values = [
  {
    no: '01',
    title: 'Söylenmeyen risk, risktir',
    text: 'Bir işlemin vergi riski varsa, o riski işlem yapılmadan önce yazılı olarak bildiririz. Sonradan açıklanan risk, danışmanlık değildir.',
  },
  {
    no: '02',
    title: 'Kapsam baştan yazılır',
    text: 'Hangi işin dahil olduğu, hangisinin ek ücrete tabi olduğu ilk teklifte bellidir. Ay sonunda sürpriz kalem çıkmaz.',
  },
  {
    no: '03',
    title: 'Yasal sınır esnetilmez',
    text: 'Vergi planlaması yaparız; vergi kaçırma yöntemi önermeyiz. Bu bir tercih değil, mesleğin ruhsat şartıdır.',
  },
  {
    no: '04',
    title: 'Büyüklük hedef değil',
    text: 'Mükellef sayısını, her dosyanın bir ortak tarafından biliniyor olmasını bozmayacak kadar tutuyoruz.',
  },
];
---

<Base
  title="Hakkımızda"
  description={`${site.foundedYear}’den bu yana İstanbul Şişli’de faaliyet gösteren serbest muhasebeci mali müşavirlik bürosu. Çalışma ilkelerimiz ve büro hakkında.`}
  path="/hakkimizda"
>
  <PageHeader
    eyebrow="Hakkımızda"
    title="Küçük kalmayı tercih eden bir büro."
    lead="Bir mali müşavirlik bürosunun büyümesi kolaydır; her dosyayı bilerek büyümesi değil. Biz ikincisini seçtik."
    meta={[
      { label: 'Kuruluş', value: String(site.foundedYear) },
      { label: 'Ekip', value: `${team.length} kişi` },
      { label: 'Oda', value: 'İstanbul SMMMO' },
      { label: 'Konum', value: `${site.address.locality} / ${site.address.region}` },
    ]}
    image={headerImg}
    imageAlt="Cam cephede yansıyan geometrik çizgiler"
  />

  <section class="shell py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8" data-reveal-group>
      <div class="md:col-span-7 prose-tr">
        <p class="text-[1.25rem] leading-relaxed text-ink md:text-[1.375rem]" data-reveal>
          Büromuzun hikâyesi, kurucumuz Ali Doğan’ın 1988’de Fatih Ticaret Lisesi stajyeri olarak
          Şişli’de başladığı meslek hayatıyla başlar. Aynı büroda dokuz yıl çalıştıktan sonra
          askerliğini tamamladı; sırasıyla turizm ve sanayi sektörlerinde muhasebe müdürü olarak
          görev yaptı.
        </p>
        <p class="mt-8 text-[1.0625rem] leading-relaxed" data-reveal>
          2003 yılının Ocak ayında kendi ofisini kurdu. 2019’da bu birikimi kurumsal bir yapıya
          taşıyarak Etik SM Mali Müşavirlik A.Ş.’yi kurdu ve mükelleflerinin çözüm ortağı olmayı
          kurumsal bir çizgide sürdürdü.
        </p>
        <p class="mt-6 text-[1.0625rem] leading-relaxed" data-reveal>
          Çalışma düzenimizin merkezinde tek bir kural var: her dosya kurucu ortak tarafından
          biliniyor. Bu, kaç mükellefe hizmet verebileceğimizi doğrudan sınırlıyor — ve bu sınırı
          bilerek koruyoruz. Aradığınızda size “dosyanıza bakayım” denmesini değil, durumunuzun
          bilinmesini bekleyebilirsiniz.
        </p>
        <p class="mt-6 text-[1.0625rem] leading-relaxed" data-reveal>
          Mesleki sorumluluğumuz 3568 sayılı Kanun ve TÜRMOB mevzuatı ile çizilidir. Bu çerçeve
          bizim için bir kısıt değil, mükellefe verdiğimiz asıl güvence: hangi işin yapılabileceği
          kadar, hangisinin yapılamayacağını da söylemek meslek gereğidir.
        </p>
      </div>

      <aside class="md:col-span-4 md:col-start-9" data-reveal>
        <div class="border-t border-line pt-6">
          <h2 class="eyebrow">Kimlere hizmet veriyoruz</h2>
          <ul class="mt-5 space-y-3 text-[0.9375rem] text-ink-2">
            <li class="border-b border-line-soft pb-3">KOBİ’ler ve aile şirketleri</li>
            <li class="border-b border-line-soft pb-3">E-ticaret ve pazaryeri satıcıları</li>
            <li class="border-b border-line-soft pb-3">Yazılım şirketleri ve ajanslar</li>
            <li class="border-b border-line-soft pb-3">Serbest meslek erbabı</li>
            <li class="pb-1">Yeni kurulan şirketler</li>
          </ul>
          <p class="mt-6 text-[0.8125rem] leading-relaxed text-muted">
            Mükellef isimleri meslek sırrı kapsamındadır; referans olarak hiçbir şirket adı
            paylaşılmaz.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="shell pb-16 md:pb-20" aria-labelledby="misyon-baslik">
    <div class="grid gap-10 border-t border-line pt-12 md:grid-cols-2 md:gap-16" data-reveal-group>
      <div data-reveal>
        <p class="eyebrow" id="misyon-baslik">Misyonumuz</p>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-2">
          İşletmelerin ve toplumun ekonomik hayatına yönelik doğru, güvenilir ve şeffaf bilgi
          sunmak; finansal süreçlerin mevzuata, mesleki standartlara ve etik değerlere uygun
          yürütülmesini sağlamak; mesleki bilgi ve yetkinlikle mükelleflere rehberlik ederek kamu
          yararına, adalete ve ekonomik güvene katkı sağlamaktır.
        </p>
        <p class="mt-4 text-[0.9375rem] font-semibold text-ink">
          Doğru bilgi, güvenilir hizmet, etik sorumlulukla.
        </p>
      </div>
      <div data-reveal>
        <p class="eyebrow">Vizyonumuz</p>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-2">
          Gerçek ve tüzel kişilere muhasebe ve vergi danışmanlığı hizmeti sunan, çözüm odaklı
          hareket eden, etik değerlere bağlı bir anlayışla; bu hizmeti güven ilişkisi içinde,
          uzmanlıkla ve sonuç odaklı biçimde — vergi için değil bilgi için — sunmayı, sürekli
          değişen mevzuatı ve dünyadaki gelişmeleri yakından takip etmeyi öncelikli sayıyoruz.
        </p>
        <p class="mt-4 text-[0.9375rem] font-semibold text-ink">
          Etik değerleriyle güven veren, bilgisiyle geleceğe yön veren bir anlayışla.
        </p>
      </div>
    </div>
  </section>

  <section class="shell pb-16 md:pb-24" aria-labelledby="ilke-baslik">
    <div class="border-t border-line pt-12">
      <p class="eyebrow">İlkeler</p>
      <h2 id="ilke-baslik" class="mt-4 max-w-[20ch] text-[2.25rem] md:text-[2.75rem]">
        Dört maddeye sığıyor.
      </h2>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 md:gap-x-8" data-reveal-group>
        {
          values.map((v) => (
            <article data-reveal>
              <div class="rule mb-5" data-rule-draw />
              <p class="eyebrow tnum">{v.no}</p>
              <h3 class="mt-3 text-[1.5rem] leading-snug">{v.title}</h3>
              <p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2">{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
