---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---

<Base
  title="Sayfa bulunamadı"
  description="Aradığınız sayfa bulunamadı. Etik Mali Müşavirlik ana sayfasına dönebilir veya hizmetleri inceleyebilirsiniz."
  path="/404"
>
  <section class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="eyebrow tnum">Hata 404</p>
    <h1 class="mt-6 max-w-[18ch] text-[2.75rem] leading-[1.05] md:text-[4rem]">
      Bu sayfa kayıtlarımızda görünmüyor.
    </h1>
    <p class="mt-6 max-w-[52ch] text-[1.0625rem] leading-relaxed text-ink-2">
      Adres değişmiş veya sayfa kaldırılmış olabilir. Aşağıdaki başlıklardan devam edebilirsiniz.
    </p>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <li><a href="/" class="link-draw text-accent">Ana sayfa</a></li>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="link-draw text-accent">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
