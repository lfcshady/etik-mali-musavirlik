---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
import headerImg from '../../assets/glass-wall.jpg';

export function getStaticPaths() {
  return services.map((service, index) => ({
    params: { slug: service.slug },
    props: {
      service,
      next: services[(index + 1) % services.length],
    },
  }));
}

const { service, next } = Astro.props;
---

<Base
  title={service.title}
  description={service.summary}
  path={`/hizmetler/${service.slug}`}
>
  <PageHeader
    eyebrow={`Hizmet ${service.no} · Mali Müşavirlik`}
    title={service.title}
    lead={service.summary}
    meta={[
      { label: 'Sıklık', value: service.cadence },
      { label: 'Hizmet no', value: service.no },
    ]}
    image={headerImg}
    imageAlt="Cam bir cephenin yakın planı"
  />

  <section class="shell py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8" data-reveal-group>
      <div class="md:col-span-7">
        <h2 class="eyebrow" data-reveal>Kapsam</h2>
        <ul class="mt-6 border-t border-line">
          {
            service.scope.map((item, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-4" data-reveal>
                <span class="eyebrow tnum pt-1">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[1.0625rem] leading-relaxed">{item}</span>
              </li>
            ))
          }
        </ul>

        <p
          class="mt-10 max-w-[60ch] border-l-2 border-accent pl-5 text-[1.0625rem] leading-relaxed text-ink-2"
          data-reveal
        >
          {service.signal}
        </p>
      </div>

      <aside class="md:col-span-4 md:col-start-9" data-reveal>
        <div class="border border-line bg-surface p-6">
          <h2 class="eyebrow">Kimin için</h2>
          <p class="mt-4 text-[1.0625rem] leading-relaxed">{service.audience}</p>
          <div class="mt-7 border-t border-line pt-6">
            <p class="text-[0.9375rem] leading-relaxed text-ink-2">
              Bu başlık size uygun mu, 15 dakikalık bir görüşmede netleşir.
            </p>
            <a href="/iletisim" class="btn mt-5 w-full justify-center">Görüşme talep edin</a>
          </div>
        </div>

        <a
          href={`/hizmetler/${next.slug}`}
          class="group mt-8 block border-t border-line pt-5"
        >
          <span class="eyebrow">Sıradaki hizmet</span>
          <span
            class="mt-2 block font-display text-[1.5rem] leading-snug transition-colors duration-500 group-hover:text-accent"
            >{next.title} <span aria-hidden="true">→</span></span
          >
        </a>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>
