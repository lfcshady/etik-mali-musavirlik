---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, telHref, mailHref, waHref, addressLine } from '../data/site';
import headerImg from '../assets/skyline-up.jpg';

// Static site, no backend. In taslak mode the form submits nowhere and shows a notice;
// at go-live it is wired to the practice’s own address. See _shared/taslak-mode.md §3.
const subjects = [
  'Muhasebe ve defter tutma',
  'Bordro ve özlük işleri',
  'Vergi danışmanlığı',
  'Şirket kuruluşu',
  'E-ticaret muhasebesi',
  'Teşvik ve destekler',
  'Diğer',
];
---

<Base
  title="İletişim"
  description={`Etik Mali Müşavirlik — ${addressLine}. Telefon, WhatsApp, e-posta ve konum bilgileri. İlk görüşme ücretsizdir.`}
  path="/iletisim"
>
  <PageHeader
    eyebrow="İletişim"
    title="İlk görüşme ücretsiz."
    lead="Mevcut kaydınıza bakar, eksik varsa söyler, kapsamı ve ücreti yazılı olarak paylaşırız. Bir şey satmaya çalışmadan."
    meta={[
      { label: 'Telefon', value: site.phoneDisplay },
      { label: 'Çalışma saatleri', value: 'Pzt–Cum 09:30–18:30' },
    ]}
    image={headerImg}
    imageAlt="Aşağıdan yukarı bakan açıyla iş merkezi kuleleri"
  />

  <section class="shell py-14 md:py-20">
    <div class="grid gap-14 md:grid-cols-12 md:gap-8">
      <!-- Channels -->
      <div class="md:col-span-4" data-reveal-group>
        <h2 class="eyebrow" data-reveal>Doğrudan ulaşın</h2>
        <dl class="mt-6 border-t border-line" data-reveal>
          <div class="border-b border-line py-5">
            <dt class="eyebrow">Telefon</dt>
            <dd class="mt-2">
              <a href={telHref} class="link-draw text-[1.25rem]">{site.phoneDisplay}</a>
            </dd>
          </div>
          <div class="border-b border-line py-5">
            <dt class="eyebrow">WhatsApp</dt>
            <dd class="mt-2">
              <a
                href={waHref('Merhaba, mali müşavirlik hizmetleriniz hakkında bilgi almak istiyorum.')}
                target="_blank"
                rel="noopener noreferrer"
                class="link-draw text-[1.25rem]">{site.whatsappDisplay}</a
              >
            </dd>
          </div>
          <div class="border-b border-line py-5">
            <dt class="eyebrow">E-posta</dt>
            <dd class="mt-2">
              <a href={mailHref} class="link-draw text-[1.125rem]">{site.email}</a>
            </dd>
          </div>
          <div class="border-b border-line py-5">
            <dt class="eyebrow">Adres</dt>
            <dd class="mt-2">
              <a
                href={site.maps.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link-draw text-[1.0625rem] leading-relaxed">{addressLine}</a
              >
            </dd>
          </div>
        </dl>

        <div class="mt-8" data-reveal>
          <h2 class="eyebrow">Çalışma saatleri</h2>
          <dl class="mt-4 space-y-2 text-[0.9375rem]">
            {
              site.hours.map((h) => (
                <div class="flex justify-between gap-4 border-b border-line-soft pb-2">
                  <dt class="text-ink-2">{h.days}</dt>
                  <dd class="tnum">{h.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <!-- Form -->
      <div class="md:col-span-7 md:col-start-6" data-reveal-group>
        <h2 class="eyebrow" data-reveal>Görüşme talebi</h2>
        <p class="mt-4 max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2" data-reveal>
          Form, taslak sunumda henüz bir yere bağlı değildir; gönderdiğinizde hiçbir veri iletilmez.
          Yayına alınırken büronun kendi e-posta adresine bağlanır.
        </p>

        <form id="contact-form" class="mt-8 space-y-6" data-reveal>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="c-name" class="eyebrow">Ad soyad</label>
              <input
                id="c-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-2 w-full border-b border-line bg-transparent py-2.5 text-[1.0625rem] outline-none transition-colors focus:border-accent"
              />
            </div>
            <div>
              <label for="c-company" class="eyebrow">Firma (varsa)</label>
              <input
                id="c-company"
                name="company"
                type="text"
                autocomplete="organization"
                class="mt-2 w-full border-b border-line bg-transparent py-2.5 text-[1.0625rem] outline-none transition-colors focus:border-accent"
              />
            </div>
            <div>
              <label for="c-phone" class="eyebrow">Telefon</label>
              <input
                id="c-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="mt-2 w-full border-b border-line bg-transparent py-2.5 text-[1.0625rem] outline-none transition-colors focus:border-accent"
              />
            </div>
            <div>
              <label for="c-subject" class="eyebrow">Konu</label>
              <select
                id="c-subject"
                name="subject"
                class="mt-2 w-full border-b border-line bg-transparent py-2.5 text-[1.0625rem] outline-none transition-colors focus:border-accent"
              >
                {subjects.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label for="c-message" class="eyebrow">Kısaca durumunuz</label>
            <textarea
              id="c-message"
              name="message"
              rows="5"
              class="mt-2 w-full resize-y border-b border-line bg-transparent py-2.5 text-[1.0625rem] leading-relaxed outline-none transition-colors focus:border-accent"
              placeholder="Mükellefiyet türü, personel sayısı, şu an nasıl bir hizmet aldığınız…"></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <button type="submit" class="btn">Gönder</button>
            <p class="text-[0.8125rem] text-muted">
              Paylaştığınız bilgiler meslek sırrı kapsamındadır.
            </p>
          </div>

          <p
            id="form-status"
            role="status"
            hidden
            class="border-l-2 border-accent bg-surface px-5 py-4 text-[0.9375rem] leading-relaxed"
          >
            <strong class="font-semibold">Taslak — form henüz bağlı değil.</strong> Bu sunumda form
            gönderimi yapılmaz ve girdiğiniz bilgiler hiçbir yere iletilmez. Site yayına alındığında
            mesajlar doğrudan büronun e-posta adresine ulaşacak.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="shell pb-16 md:pb-24" aria-labelledby="konum-baslik">
    <div class="border-t border-line pt-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Konum</p>
          <h2 id="konum-baslik" class="mt-4 text-[2rem] md:text-[2.5rem]">
            {site.address.locality} / {site.address.region}
          </h2>
        </div>
        <a
          href={site.maps.url}
          target="_blank"
          rel="noopener noreferrer"
          class="link-draw pb-1 text-[0.9375rem] text-accent">Haritada açın →</a
        >
      </div>
      <div class="mt-8 border border-line">
        <iframe
          src={site.maps.embed}
          title={`${site.name} konumu — Google Haritalar`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-[380px] w-full grayscale-[0.35] md:h-[460px]"></iframe>
      </div>
    </div>
  </section>

  <script>
    // Taslak build: the form deliberately submits nowhere (_shared/taslak-mode.md §3).
    // At go-live this handler is replaced by the real delivery method.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (status) {
        status.hidden = false;
        status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  </script>
</Base>
