---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import headerImg from '../assets/facade-grid.jpg';

// The list the client is walked through when asking for their own material.
// Mirrors site/DEMO.md — keep the two in step.
const groups = [
  {
    title: 'İletişim bilgileri',
    note: 'Ofisten gelen özgeçmiş belgesiyle gerçek bilgiyle dolduruldu; birkaç kalem hâlâ teyit bekliyor.',
    items: [
      '✓ Adres: 19 Mayıs Mah. Büyükdere Cad. No:8 Güzel Abant Apt D:4, Şişli/İstanbul',
      '✓ E-posta: alidogan@etikmalimusavirlik.org',
      '✓ Çalışma saatleri: Hafta içi 09:30–18:30, hafta sonu kapalı',
      '✓ Sabit hat: 0212 225 66 66',
      '✓ Gsm / WhatsApp: 0507 768 68 10',
      '✓ Posta kodu: 34363 (PTT mahalle kodu, internetten alındı — kesinleşmiş adres bilgisi değil)',
      '✗ Harita konumu (şu an metin aramalı, işletme profili pin\'i değil)',
      '✗ LinkedIn ve Instagram hesapları (şu an platform ana sayfaları)',
      '✗ Alan adı — henüz satın alınmadı, taslak placeholder ile bekliyor',
    ],
  },
  {
    title: 'Ekip',
    note: 'Kurucu Ali Doğan gerçek özgeçmişiyle eklendi; kurgu üç kişi kaldırıldı.',
    items: [
      '✓ Ali Doğan — Kurucu · SMMM, 2019',
      '✗ Büroda başka meslek mensubu/çalışan varsa isim, unvan, katılım yılı',
      '✗ Kısa özgeçmiş metinleri (diğer ekip üyeleri için)',
      '✗ Ekip fotoğrafları (şu an baş harf kutusu kullanılıyor)',
    ],
  },
  {
    title: 'Büro bilgileri',
    note: 'Misyon, vizyon ve büro hikâyesi ofisten gelen belgeyle dolduruldu.',
    items: [
      '✓ Büro hikâyesi, misyon ve vizyon metinleri (Hakkımızda sayfası)',
      '✓ Kuruluş yılı: 2019 (Etik SM Mali Müşavirlik A.Ş.)',
      '✗ Aktif mükellef sayısı (şu an 120 — varsayım, gerçek sayı gerekli)',
      '✓ İstanbul SMMM Odası üyeliği',
      '✗ Hizmet kapsam maddelerinin ofis tarafından teyidi',
    ],
  },
  {
    title: 'Görseller',
    note: 'Tümü serbest lisanslı (CC0) mimari fotoğraflardır; büroya ait değildir.',
    items: [
      'Ana sayfa kapak görseli',
      'Bölüm ve sayfa başlığı görselleri',
      'Büronun kendi ofis/bina fotoğrafları ile değiştirilmesi önerilir',
      'Ali Doğan\'ın fotoğrafı (ekip sayfasındaki baş harf kutusu yerine)',
    ],
  },
  {
    title: 'Müşteriden istenecekler',
    note: 'Bunlar kasıtlı olarak boş bırakıldı — uydurulması yasak.',
    items: [
      'SMMM ruhsat ve oda sicil numarası',
      'Vergi numarası ve ticaret sicil / MERSİS bilgisi',
      'Varsa mevcut logo ve kurumsal kimlik dosyaları',
    ],
  },
];
---

<Base
  title="Taslak hakkında"
  description="Bu sunum taslağında hangi bilgilerin temsili olduğunu ve yayın öncesi nelerin değişmesi gerektiğini gösteren liste."
  path="/taslak"
>
  <PageHeader
    eyebrow="Taslak sunum"
    title="Yayın öncesi değişecek alanlar."
    lead="Bu site, kendi bilgilerinizle doldurulmak üzere hazırlanmış bir sunum taslağıdır. Aşağıdaki her madde temsilidir ve sizden gelecek bilgiyle değiştirilecektir."
    image={headerImg}
    imageAlt="Modüler bir bina cephesinin ızgara deseni"
  />

  <section class="shell py-14 md:py-20">
    <div class="grid gap-px bg-line md:grid-cols-2" data-reveal-group>
      {
        groups.map((g) => (
          <article class="bg-paper p-7 md:p-8" data-reveal>
            <h2 class="text-[1.5rem] leading-tight md:text-[1.75rem]">{g.title}</h2>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{g.note}</p>
            <ul class="mt-5 space-y-2.5">
              {g.items.map((item) => (
                <li class="flex gap-3 border-b border-line-soft pb-2.5 text-[0.9375rem]">
                  <span aria-hidden="true" class="text-accent">
                    ·
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="mt-10 max-w-[70ch] border-l-2 border-accent pl-5 text-[0.9375rem] leading-relaxed text-ink-2">
      Hesaplama aracındaki vergi ve SGK oranları temsili değildir — {''}
      <strong class="font-semibold">2025 yılının resmî parametreleridir</strong> ve doğru çalışır.
      Yalnızca bilgilendirme amaçlı olduğu notu her sonucun altında yer alır.
    </p>
  </section>
</Base>
