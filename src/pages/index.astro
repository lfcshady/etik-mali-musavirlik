---
import Base from '../layouts/Base.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import { activeRates } from '../data/rates';

const principles = [
  {
    no: '01',
    title: 'Takvimi biz takip ederiz',
    text: 'Beyanname ve ödeme son günlerini hatırlamak sizin işiniz değil. Yükümlülük doğduğunda tutarı ve tarihi siz sormadan iletiriz.',
  },
  {
    no: '02',
    title: 'Dosyanızı bilen kişiye ulaşırsınız',
    text: 'Her mükellefin dosyası en az bir ortak tarafından bilinir. Aradığınızda durumu baştan anlatmak zorunda kalmazsınız.',
  },
  {
    no: '03',
    title: 'Rakam karar için üretilir',
    text: 'Beyanname vergiye, rapor karara hizmet eder. Aylık yönetim raporu, yıl sonunu beklemeden nerede durduğunuzu gösterir.',
  },
];

const steps = [
  { no: '01', title: 'Tanışma görüşmesi', text: 'Mevcut kaydınıza ve mükellefiyet yapınıza bakarız. Ücretsizdir.' },
  { no: '02', title: 'Kapsam ve teklif', text: 'Hangi işin yapılacağı ve ücreti yazılı olarak paylaşılır.' },
  { no: '03', title: 'Devir', text: 'Defter ve belgeler devralınır, eksikler devirden önce raporlanır.' },
  { no: '04', title: 'Aylık döngü', text: 'Kayıt, mutabakat, beyanname ve yönetim raporu. Takvim bizde.' },
];

const minWage = activeRates.minWageGross.toLocaleString('tr-TR', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
---

<Base
  title="Etik Mali Müşavirlik — İstanbul SMMM Bürosu"
  description="İstanbul Şişli’de serbest muhasebeci mali müşavirlik bürosu. Muhasebe, bordro, vergi danışmanlığı, e-ticaret muhasebesi ve teşvik başvuruları. İlk görüşme ücretsiz."
  path="/"
  headerVariant="flush"
>
  <!-- Hero -->
  <section class="border-b border-line">
    <div class="shell pt-10 pb-16 md:pt-20 md:pb-24" data-reveal-group>
      <div class="grid gap-12 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-7">
          <p class="eyebrow" data-reveal>
            Serbest Muhasebeci Mali Müşavirlik · İstanbul
          </p>
          <h1
            class="mt-7 text-[2.75rem] leading-[1.04] md:text-[4rem] lg:text-[4.75rem]"
            data-reveal
          >
            Muhasebeniz, <span class="italic text-accent">sürpriz</span> üretmemeli.
          </h1>
          <p
            class="mt-8 max-w-[54ch] text-[1.125rem] leading-relaxed text-ink-2"
            data-reveal
          >
            Etik Mali Müşavirlik, {site.foundedYear} yılından bu yana İstanbul’da KOBİ’lerin,
            e-ticaret satıcılarının ve serbest meslek erbabının muhasebe, bordro ve vergi süreçlerini
            yürütüyor. Küçük bir ekibiz; bu, dosyanızın kimde olduğunu bilmeniz demek.
          </p>
          <div class="mt-10 flex flex-wrap gap-3" data-reveal>
            <a href="/iletisim" class="btn">Ücretsiz ön görüşme</a>
            <a href="/hizmetler" class="btn-ghost">Hizmetleri inceleyin</a>
          </div>
        </div>

        <!-- Masthead block: the page's only "data" panel, and what replaces photography. -->
        <div class="md:col-span-4 md:col-start-9" data-reveal>
          <dl class="border-t border-line">
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-4">
              <dt class="eyebrow">Kuruluş</dt>
              <dd class="font-display text-[1.5rem] tnum" data-num>{site.foundedYear}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-4">
              <dt class="eyebrow">Ekip</dt>
              <dd class="font-display text-[1.5rem] tnum">{team.length} kişi</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-4">
              <dt class="eyebrow">Aktif mükellef</dt>
              <dd class="font-display text-[1.5rem] tnum">
                <span data-count="120" data-count-suffix="">120</span>
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-4">
              <dt class="eyebrow">Oda</dt>
              <dd class="text-right text-[0.9375rem]">{site.chamber}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-4">
              <dt class="eyebrow">Konum</dt>
              <dd class="text-right text-[0.9375rem]">
                {site.address.locality} / {site.address.region}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="shell py-16 md:py-24" aria-labelledby="ilke-baslik">
    <h2 id="ilke-baslik" class="sr-only">Çalışma ilkelerimiz</h2>
    <div class="grid gap-10 md:grid-cols-3 md:gap-8" data-reveal-group>
      {
        principles.map((p) => (
          <article data-reveal>
            <div class="rule mb-6" data-rule-draw />
            <p class="eyebrow tnum">{p.no}</p>
            <h3 class="mt-4 text-[1.5rem] leading-snug md:text-[1.75rem]">{p.title}</h3>
            <p class="mt-4 max-w-[38ch] text-[0.9375rem] leading-relaxed text-ink-2">{p.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="shell pb-4 md:pb-8" aria-labelledby="hizmet-baslik">
    <div class="flex flex-wrap items-end justify-between gap-6 pb-8" data-reveal-group>
      <div data-reveal>
        <p class="eyebrow">Hizmetler</p>
        <h2 id="hizmet-baslik" class="mt-4 text-[2.25rem] md:text-[3rem]">
          Yedi başlık, tek muhatap.
        </h2>
      </div>
      <a href="/hizmetler" class="link-draw pb-1 text-[0.9375rem] text-accent" data-reveal>
        Tüm hizmetler →
      </a>
    </div>
    <ServiceIndex />
  </section>

  <!-- Calculator band — the site's one inverted section, and its one interactive tool. -->
  <section class="mt-20 bg-deep py-16 text-paper md:mt-28 md:py-24" aria-labelledby="arac-baslik">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-8" data-reveal-group>
      <div class="md:col-span-6">
        <p class="eyebrow text-paper/45" data-reveal>Ücretsiz araç</p>
        <h2 id="arac-baslik" class="mt-5 text-[2.25rem] md:text-[3rem]" data-reveal>
          Net maaş hesaplama
        </h2>
        <p class="mt-6 max-w-[50ch] text-[1.0625rem] leading-relaxed text-paper/70" data-reveal>
          Brütten nete, netten brüte. Gelir vergisi dilimi, SGK payları, damga vergisi ve asgari ücret
          istisnası dahil — üstelik 12 ayın tamamı için. Hesap tarayıcınızda çalışır, girdiğiniz tutar
          hiçbir yere gönderilmez.
        </p>
        <a href="/araclar/maas-hesaplama" class="mt-9 inline-flex btn border-paper bg-paper text-deep hover:bg-transparent hover:text-paper" data-reveal>
          Hesaplamayı açın
        </a>
      </div>

      <div class="md:col-span-5 md:col-start-8" data-reveal>
        <dl class="border-t border-line-invert">
          <div class="flex items-baseline justify-between gap-4 border-b border-line-invert py-4">
            <dt class="eyebrow text-paper/45">{activeRates.year} asgari ücret (brüt)</dt>
            <dd class="font-display text-[1.375rem] tnum">{minWage} ₺</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-line-invert py-4">
            <dt class="eyebrow text-paper/45">SGK işçi payı</dt>
            <dd class="font-display text-[1.375rem] tnum">%14</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-line-invert py-4">
            <dt class="eyebrow text-paper/45">Damga vergisi</dt>
            <dd class="font-display text-[1.375rem] tnum">binde 7,59</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-4">
            <dt class="eyebrow text-paper/45">Gelir vergisi ilk dilim</dt>
            <dd class="font-display text-[1.375rem] tnum">%15</dd>
          </div>
        </dl>
        <p class="mt-5 text-[0.8125rem] leading-relaxed text-paper/45">
          {activeRates.year} yılı resmî parametreleri. Bilgilendirme amaçlıdır, bağlayıcı değildir.
        </p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="shell py-16 md:py-24" aria-labelledby="surec-baslik">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8" data-reveal-group>
      <div class="md:col-span-4">
        <p class="eyebrow" data-reveal>Süreç</p>
        <h2 id="surec-baslik" class="mt-5 text-[2.25rem] md:text-[2.75rem]" data-reveal>
          Başlarken ne oluyor?
        </h2>
        <p class="mt-6 max-w-[38ch] text-[0.9375rem] leading-relaxed text-ink-2" data-reveal>
          Mevcut müşavirinizden devir dahil, ilk ay genelde bir haftada tamamlanır.
        </p>
      </div>
      <ol class="md:col-span-7 md:col-start-6">
        {
          steps.map((s) => (
            <li class="grid grid-cols-[3rem_1fr] gap-x-5 border-b border-line py-6" data-reveal>
              <span class="eyebrow tnum pt-1">{s.no}</span>
              <div>
                <h3 class="text-[1.375rem] leading-snug">{s.title}</h3>
                <p class="mt-2 max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2">
                  {s.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Team preview -->
  <section class="shell pb-16 md:pb-24" aria-labelledby="ekip-baslik">
    <div class="flex flex-wrap items-end justify-between gap-6 border-t border-line pt-12" data-reveal-group>
      <div data-reveal>
        <p class="eyebrow">Ekip</p>
        <h2 id="ekip-baslik" class="mt-4 text-[2.25rem] md:text-[2.75rem]">
          Dört kişi, isimleriyle.
        </h2>
      </div>
      <a href="/ekip" class="link-draw pb-1 text-[0.9375rem] text-accent" data-reveal>Ekibi görün →</a>
    </div>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        team.map((m) => (
          <article class="border-t border-line pt-5" data-reveal>
            <h3 class="text-[1.375rem] leading-snug">{m.name}</h3>
            <p class="eyebrow mt-2">{m.title}</p>
            <p class="mt-4 text-[0.875rem] leading-relaxed text-muted">{m.focus.join(' · ')}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section class="shell pb-16 md:pb-24" aria-labelledby="sss-baslik">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <p class="eyebrow">Sık sorulanlar</p>
        <h2 id="sss-baslik" class="mt-5 text-[2.25rem] md:text-[2.75rem]">
          Genelde ilk sorulanlar.
        </h2>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        <Faq limit={4} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
