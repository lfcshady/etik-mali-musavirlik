---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { team } from '../data/team';
---

<Base
  title="Ekip"
  description="Etik Mali Müşavirlik ekibi: kurucu ortak, ortak, kıdemli muhasebe uzmanı ve bordro uzmanı. Dosyanızı kimin yürüttüğünü bilirsiniz."
  path="/ekip"
>
  <PageHeader
    eyebrow="Ekip"
    title="Dosyanızı kimin yürüttüğünü bilirsiniz."
    lead="Dört kişilik bir büroda muhatap belirsizliği olmaz. Her mükellefin dosyası en az bir ortak tarafından bilinir."
    meta={[
      { label: 'Ekip', value: `${team.length} kişi` },
      { label: 'Ruhsatlı meslek mensubu', value: '2 SMMM' },
    ]}
  />

  <section class="shell py-14 md:py-20">
    <div class="border-t border-line" data-reveal-group>
      {
        team.map((m) => (
          <article
            class="grid gap-6 border-b border-line py-9 md:grid-cols-12 md:gap-8 md:py-12"
            data-reveal
          >
            <div class="md:col-span-4">
              <h2 class="text-[1.875rem] leading-tight md:text-[2.25rem]">{m.name}</h2>
              <p class="eyebrow mt-3">{m.title}</p>
              <p class="eyebrow mt-1.5 tnum">Büroda {m.since}’den beri</p>
            </div>
            <div class="md:col-span-5">
              <p class="max-w-[52ch] text-[1.0625rem] leading-relaxed text-ink-2">{m.bio}</p>
            </div>
            <div class="md:col-span-3">
              <p class="eyebrow">Odak</p>
              <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-ink-2">
                {m.focus.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-8 max-w-[70ch] text-[0.875rem] leading-relaxed text-muted">
      Serbest Muhasebeci Mali Müşavir (SMMM) unvanı 3568 sayılı Kanun kapsamında ruhsata tabidir.
      Büromuz İstanbul Serbest Muhasebeci Mali Müşavirler Odası’na kayıtlıdır.
    </p>
  </section>

  <CtaBand
    title="Kiminle çalışacağınızı önce tanıyın."
    text="İlk görüşme, dosyanızı yürütecek ortakla yapılır. Satış görüşmesi değildir: mevcut durumunuza bakar, eksik varsa söyler, kapsamı yazılı olarak paylaşırız."
  />
</Base>
